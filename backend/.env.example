# Answer generation (Groq by default). Configure only keys you use.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b
# Empty uses LLM_MODEL for validation.
VALIDATOR_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Independent OCR provider. Create a Gemini key in Google AI Studio.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite
# Conservative pacing; set this to your model's actual AI Studio RPM limit.
GEMINI_OCR_REQUESTS_PER_MINUTE=10
# Includes Gemini reasoning and transcription; avoids crops on dense two-column pages.
GEMINI_OCR_MAX_OUTPUT_TOKENS=4096
# Two adjacent scans per request; 1 restores individual-page processing.
GEMINI_OCR_BATCH_PAGES=2
VISION_MAX_OUTPUT_TOKENS=1800
OCR_RENDER_DPI=180
OCR_MIN_WORDS_THRESHOLD=30
OCR_CALL_DELAY_SECONDS=3
OCR_PROVIDER_RETRIES=6
OCR_MAX_WAIT_SECONDS=300
PROVIDER_MAX_WAIT_SECONDS=120
VALIDATION_BATCH_TOKENS=3200
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_RETRIES=2

# Local models. Changing embeddings requires reindexing.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=350
CHUNK_OVERLAP=50

# Backend only: never expose the service-role key to Vite/browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Optional for scripts/test_guest_isolation_live.py; normal API requests do not use it.
SUPABASE_ANON_KEY=
STORAGE_BUCKET=study-originals

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=30
MAX_DOCUMENT_PAGES=150
MAX_RETRIES=1
GENERATION_RETRIES=1
RELEVANCE_THRESHOLD=0.45
FAST_ANSWER_RELEVANCE_THRESHOLD=0.85
FAST_ANSWER_CONTEXT_TOKENS=3200
FAST_ANSWER_MAX_TOKENS=1600
GROUNDEDNESS_THRESHOLD=0.7
TOP_K_INITIAL=24
TOP_K_FINAL=8
VECTOR_SIMILARITY_THRESHOLD=0.25
NEIGHBOR_WINDOW=1
CONTEXT_TOKEN_BUDGET=6000
ANSWER_MAX_TOKENS=3500
SUMMARY_SECTION_TOKENS=2500
SUMMARY_REDUCE_TOKENS=6000
SUMMARY_MAX_SECTIONS=120

# Maximum source-check input per structured Ask batch.
ASK_VALIDATION_BATCH_TOKENS=4500
